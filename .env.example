# ============================================================
# GammaTR — Variables de entorno de ejemplo
# ============================================================
# IMPORTANTE: Este archivo es SOLO un ejemplo.
# Las claves reales NO se guardan aquí ni en el repositorio.
# La app las guarda en localStorage del navegador.
# ============================================================

# Clave de API de Google Gemini
# Obtenla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...tu_clave_aqui...

# URL de tu proyecto Supabase
# Encuéntrala en: Settings > API de tu proyecto
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima de Supabase (anon/public key)
# Encuéntrala en: Settings > API > anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# NUNCA subas un archivo .env con claves reales al repositorio
# Este archivo .env.example es seguro porque contiene placeholders
# ============================================================
